{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": ["DOM", "ES2020"],
    "types": ["node"]
  },
  "include": ["src/ts/**/*.ts", "src/ts/**/*.d.ts", "config/**/*.ts", "vite.config.ts", "tailwind.config.ts"]
}
